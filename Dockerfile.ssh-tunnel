FROM node:24-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/ssh-tunnel-entrypoint.sh /usr/local/bin/ssh-tunnel-entrypoint
RUN chmod 755 /usr/local/bin/ssh-tunnel-entrypoint

ENTRYPOINT ["/usr/local/bin/ssh-tunnel-entrypoint"]
